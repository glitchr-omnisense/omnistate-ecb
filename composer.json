{
    "name": "omnistate/ecb",
    "type": "library",
    "description": "Omnistate ECB: the European Central Bank's statistics from its Data Portal's SDMX web service (no key) - euro foreign exchange reference rates, key interest rates, every series by its dataflow and key.",
    "keywords": ["ecb", "european central bank", "sdmx", "statistics", "exchange rates", "interest rates", "euro", "omnistate"],
    "homepage": "https://github.com/glitchr-omnisense/omnistate-ecb",
    "license": "MIT",
    "authors": [{"name": "Marco Meyer", "email": "marco.meyer@glitchr.io"}],
    "require": {
        "php": ">=8.2",
        "ext-simplexml": "*",
        "omnisense/contracts": "^1.0@dev",
        "omnisense/omnistate": "^1.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {"psr-4": {"Omnistate\\Ecb\\": ""}, "exclude-from-classmap": ["/Tests/"]},
    "autoload-dev": {"psr-4": {"Omnistate\\Ecb\\Tests\\": "Tests/"}},
    "extra": {"branch-alias": {"dev-1.x": "1.x-dev"}, "omnisense": {"policy": "policy.json"}},
    "config": {"sort-packages": true}
}
